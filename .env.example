# -----------------------------------------------------------------------------
# MyScheduler environment variables
# Copy to .env.local (or .env) and fill in real values. Never commit real secrets.
# -----------------------------------------------------------------------------

# Postgres connection string (Neon). Include ?sslmode=require for Neon.
# Example: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Single seeded login password. Set this to whatever you want to type at /login.
AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Google Calendar two-way sync (OAuth). Needs the calendar.events scope.
# Create a Web OAuth client in Google Cloud Console with redirect URIs:
#   http://localhost:3000/api/google/callback  (local)
#   https://<your-app>.vercel.app/api/google/callback  (prod)
# Leave blank to keep sync disabled — the app runs fine without these.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret protecting the /api/cron/sync endpoint. Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>". Use any long random string.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Reserved for later — NOT used yet. Leave commented out for now.
# -----------------------------------------------------------------------------

# Web Push (VAPID keys). Generate later with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
